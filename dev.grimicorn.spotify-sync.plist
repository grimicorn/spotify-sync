<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.grimicorn.spotify-sync</string>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/CHANGEME/code/spotify-playlist-sync/sync.mjs</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/CHANGEME/code/spotify-playlist-sync</string>

  <key>StartInterval</key>
  <integer>900</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/CHANGEME/code/spotify-playlist-sync/sync.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/CHANGEME/code/spotify-playlist-sync/sync.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
